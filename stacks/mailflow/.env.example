# Copy to .env on the server, then: chmod 600 .env
# LAN address and port, for example <LAN_IP>:8445
APP_PORT=
# Full URL you open in the browser
APP_URL=
# Generate each with: openssl rand -hex 32
SESSION_SECRET=
DB_PASSWORD=
REDIS_PASSWORD=
# Back this one up: without it, stored mail credentials can't be read
ENCRYPTION_KEY=
