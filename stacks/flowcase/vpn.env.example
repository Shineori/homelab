# ===== Flowcase VPN settings (ProtonVPN) =====
# 1. Go to https://account.protonvpn.com/downloads  ->  WireGuard configuration
# 2. Pick: Platform = GNU/Linux, and turn OFF "NetShield" / "Moderate NAT" if you like
# 3. Pick any server, click "Create", copy the  PrivateKey = ....  line
# 4. Paste it below (no quotes), save, then run:  docker compose up -d gluetun

VPN_SERVICE_PROVIDER=
VPN_TYPE=
WIREGUARD_PRIVATE_KEY=

# Where you want to appear to be (optional, comma separated)
SERVER_COUNTRIES=
