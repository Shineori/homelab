# Build-time config for kitsteam/excalidraw. Vite bakes these into the JS bundle,
# so changing the domain means rebuilding the image. Replace draw.example.com with your hostname.
MODE="production"
VITE_APP_STORAGE_BACKEND=http
VITE_APP_HTTP_STORAGE_BACKEND_URL=https://draw.example.com
VITE_APP_BACKEND_V2_GET_URL=https://draw.example.com
VITE_APP_BACKEND_V2_POST_URL=https://draw.example.com
VITE_APP_WS_SERVER_URL=https://draw.example.com
VITE_APP_FIREBASE_CONFIG={}
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries/
VITE_APP_PORTAL_URL=
VITE_APP_AI_BACKEND=
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=
VITE_APP_GOOGLE_ANALYTICS_ID=
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_SENTRY=true
VITE_APP_ENABLE_PWA=false
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
VITE_APP_ENABLE_ESLINT=false
