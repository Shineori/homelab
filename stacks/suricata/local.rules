# My own Suricata rules. On the server this file lives at lib/rules/local.rules
# (mounted into the container at /var/lib/suricata/rules/local.rules) and is loaded
# with the compose `command: ... -s /var/lib/suricata/rules/local.rules`.
#
# Port-scan detection by behaviour: flag any single source that fires 30+ TCP SYN
# packets at the NAS within 60 seconds. This catches an INTERNAL scanner, which the
# default ET SCAN rules miss because they only watch external->internal traffic.
alert tcp any any -> $HOME_NET any (msg:"LOCAL SCAN Possible TCP port scan from a single source"; flags:S; threshold: type both, track by_src, count 30, seconds 60; classtype:attempted-recon; sid:1000001; rev:1;)
