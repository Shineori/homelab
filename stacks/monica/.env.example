# Generate: echo -n 'base64:'; openssl rand -base64 32
APP_KEY=
DB_HOST=db
DB_DATABASE=monica
DB_USERNAME=monica
DB_PASSWORD=

APP_DISABLE_SIGNUP=true

# Public through a tunnel / reverse proxy:
APP_URL=https://<your-domain>
APP_ENV=production
APP_TRUSTED_PROXIES=*

# LAN / Tailscale only (use instead of the block above):
# APP_URL=http://<LAN_IP>:3012
