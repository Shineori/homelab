# Copy to .env on the server, then: chmod 600 .env
# LAN address the Cloudflare Tunnel connects to
BIND_IP=
# Cloudflare Zero Trust team domain (<team>.cloudflareaccess.com)
ACCESS_TEAM_DOMAIN=
# Access -> Applications -> (this app) -> Overview -> Application Audience (AUD) Tag
ACCESS_AUD=
# Optional second check on top of the Access policy: the email the IdP logs you in as
ACCESS_ALLOWED_EMAILS=
