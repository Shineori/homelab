# ---------- General ----------
TZ=
PUID=
PGID=
LISTEN_IPV6=
# Web traffic arrives through cloudflared; trust Docker networks for the real client IP
REAL_IP_FROM=
REAL_IP_HEADER=

# ---------- App ----------
APP_NAME=
# Generate:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=

# Aliases look like  anything@<redacted-domain>
#              and   anything@<username>.<redacted-domain>
ANONADDY_DOMAIN=
ANONADDY_ALL_DOMAINS=
ANONADDY_HOSTNAME=
# Your addy username. It appears in username aliases.
ANONADDY_ADMIN_USERNAME=
ANONADDY_ENABLE_REGISTRATION=
ANONADDY_NON_ADMIN_SHARED_DOMAINS=
# Generate:  openssl rand -base64 32
ANONADDY_SECRET=
ANONADDY_BANDWIDTH_LIMIT_ENABLED=
ANONADDY_LIMIT=
ANONADDY_NEW_ALIAS_LIMIT=
ANONADDY_DKIM_SELECTOR=

# ---------- Mail ----------
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# ---------- Database / Redis (hosts + password come from compose.yml) ----------
DB_DATABASE=
DB_USERNAME=

# ---------- Postfix ----------
# Opportunistic TLS when sending (no cert needed)
POSTFIX_SMTP_TLS=

# --- Outbound relay switch (OFF by default) ---
# Turn on ONLY if forwards bounce or land in spam.
# POSTFIX_RELAYHOST=
# POSTFIX_RELAYHOST_AUTH_ENABLE=
# POSTFIX_RELAYHOST_USERNAME=
# POSTFIX_RELAYHOST_PASSWORD=

# Only if logs show "blocked using zen.spamhaus.org ... open resolver":
# POSTFIX_SPAMHAUS_DQS_KEY=

# ---------- Rspamd (needed for DKIM signing + anonymous replies) ----------
RSPAMD_ENABLE=
# Generate:  openssl rand -base64 24
RSPAMD_WEB_PASSWORD=
# Greylisting delays first-time senders, which would delay 2FA codes. Off.
RSPAMD_GREYLIST_ENABLE=
